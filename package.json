{
  "name": "gameforge-studio",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:player && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "desktop:dev": "npm run desktop:setup && npm run build:player && concurrently -k \"vite --host 0.0.0.0\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:win": "npm run build && node scripts/stage-windows.mjs && electron-builder --config electron-builder.windows.json --win nsis --x64 --publish never && node scripts/checksum-installer.mjs",
    "desktop:linux": "npm run build && electron-builder --linux AppImage",
    "desktop:setup": "install-electron",
    "test:e2e": "node tests/e2e.mjs",
    "test:desktop": "node tests/desktop.mjs",
    "format": "prettier --write src desktop tests *.ts *.json *.html",
    "test:update": "node tests/update-smoke.mjs && node tests/scripts-safety.mjs",
    "test:desktop:update": "node tests/desktop-update.mjs",
    "test:studio": "node tests/studio04-browser.mjs && node tests/migration-update.mjs",
    "examples": "tsx scripts/generate-examples.ts",
    "game:generate": "tsx scripts/generate-bosque.ts",
    "test:studio05": "node tests/studio05-browser.mjs && node tests/bosque-browser.mjs",
    "test:desktop:studio05": "node tests/studio05-desktop.mjs",
    "example:lab06": "tsx scripts/generate-lab06.ts",
    "test:studio06": "node tests/studio06-browser.mjs",
    "test:studio07": "node tests/studio07-browser.mjs",
    "test:desktop:studio06": "node tests/studio06-desktop.mjs",
    "test:studio08": "node tests/studio08-browser.mjs",
    "examples:studio08": "tsx scripts/generate-studio08.ts",
    "build:player": "vite build --config vite.player.config.ts",
    "predev": "npm run build:player",
    "test:desktop:studio08": "node tests/studio08-desktop.mjs",
    "test:export:studio08": "node tests/studio08-export.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/inter": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@types/three": "^0.186.0",
    "acorn": "^8.18.0",
    "cannon-es": "^0.20.0",
    "clsx": "2.1.1",
    "fengari": "^0.1.5",
    "framer-motion": "^13.4.0",
    "luaparse": "^0.3.1",
    "lucide-react": "^0.468.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/vite": "4.1.17",
    "@types/luaparse": "^0.2.13",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "concurrently": "^9.2.1",
    "electron": "44.4.3",
    "electron-builder": "^26.0.12",
    "prettier": "^3.6.2",
    "tailwindcss": "4.1.17",
    "tsx": "^4.20.5",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "2.3.0",
    "wait-on": "^8.0.4"
  },
  "description": "Studio independente para criação de jogos 3D, com editor responsivo, física, scripts e animações",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.gameforge.studio",
    "productName": "GameForge Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/index.html",
      "dist/player.html",
      "dist/gameforge.png",
      "dist/assets/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "packaging/gameforge.ico"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development",
      "icon": "packaging/gameforge.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "GameForge"
}
